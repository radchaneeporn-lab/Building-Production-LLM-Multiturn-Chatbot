# Copy this file to .env and fill in the two required values.
# docker-compose.yml reads this file both to inject ANTHROPIC_API_KEY into
# the chatbot container and to fill in the ${VAR:-default} placeholders
# used across all three services.

# ---- Required ----------------------------------------------------------

# Your key from https://console.anthropic.com. Without this the backend
# raises an error on the first request.
ANTHROPIC_API_KEY=

# Shared secret between the frontend and backend containers. Any random
# string works for local use; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Without this the backend refuses to start.
INTERNAL_API_KEY=dev-only-not-a-secret

# ---- Optional — sensible dev defaults are already set -------------------

# The login password for the chat UI.
# APP_PASSWORD=letmein

# Signs the login cookie. Use a random string in anything beyond local use.
# COOKIE_SECRET=dev-only-cookie-secret-not-random

# Which Claude model to call, and how long a reply can be.
# MODEL_NAME=claude-haiku-4-5-20251001
# MAX_TOKENS=712
# SYSTEM_PROMPT=You are a helpful assistant. Be concise.

# Per-visitor request cap and the global daily token budget. Only enforced
# when DATABASE_URL is set (see below) — otherwise there's no rate limiter.
# RATE_LIMIT_PER_HOUR=20
# DAILY_OUTPUT_TOKEN_BUDGET=50000

# Set automatically by docker-compose.yml to point at the `db` container.
# Leave unset if you're running main_service.py directly on your machine —
# it'll fall back to a local SQLite file instead.
# DATABASE_URL=
